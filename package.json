{
  "name": "mindgest-pos-desktop",
  "version": "1.0.0",
  "description": "MindGest POS - Sistema Corporativo de Ponto de Venda e Faturação Eletrónica",
  "main": "app/main.js",
  "scripts": {
    "dev": "nextron --electron-options=\"--no-sandbox\"",
    "build": "nextron build --no-pack && electron-builder --win",
    "build:all": "nextron build --no-pack && electron-builder",
    "postinstall": "prisma generate && electron-builder install-app-deps"
  },
