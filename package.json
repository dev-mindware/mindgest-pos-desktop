{
  "name": "mindgest-pos-desktop",
  "version": "1.0.0",
  "description": "Sistema desktop de faturação e ponto de venda MindGest",
  "author": {
    "name": "MindGest"
  },
  "copyright": "Copyright © 2026 MindGest",
  "main": "app/main.js",
  "scripts": {
    "dev": "nextron",
    "build": "prisma generate && nextron build --no-pack && node scripts/fix-404.js && electron-builder",
    "build:publish": "prisma generate && nextron build --no-pack && node scripts/fix-404.js && electron-builder --publish always",
    "test": "echo 'No tests configured yet'",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "^7.29.2",
    "@hookform/resolvers": "^5.0.1",
    "@internationalized/date": "^3.8.1",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@types/better-sqlite3": "^7.6.13",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.9.0",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.0",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "electron-serve": "1.3.0",
    "electron-updater": "^6.8.3",
    "emblor": "^1.4.8",
    "express": "^5.2.1",
    "input-otp": "^1.4.2",
    "jose": "^6.0.12",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.511.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "node-machine-id": "^1.1.12",
    "node-thermal-printer": "^4.6.0",
    "nuqs": "^2.6.0",
    "print-js": "^1.6.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-aria-components": "^1.9.0",
    "react-day-picker": "^9.12.0",
    "react-dom": "19.2.4",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.56.4",
    "react-intersection-observer": "^10.0.0",
    "react-markdown": "^10.1.0",
    "react-number-format": "^5.4.4",
    "react-select": "^5.10.2",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "simple-keyboard": "^3.8.93",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.0",
    "use-debounce": "^10.0.6",
    "vaul": "^1.1.2",
    "zod": "^3.25.42",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "latest",
    "@tailwindcss/typography": "^0.5.19",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "latest",
    "@types/pdfmake": "^0.2.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "latest",
    "baseline-browser-mapping": "^2.10.0",
    "electron": "33.2.1",
    "electron-builder": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "nextron": "latest",
    "ollama": "^0.6.3",
    "orval": "^7.11.2",
    "postcss": "latest",
    "prisma": "^5.22.0",
    "tailwindcss": "latest",
    "tw-animate-css": "^1.3.2",
    "typescript": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-mindware/mindgest-pos-desktop.git"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "build": {
    "appId": "com.mindgest.pos",
    "productName": "MindGest POS",
    "executableName": "MindGest POS",
    "artifactName": "MindGest-POS-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!yolov8n.pt",
      "!*.log",
      "!dev.db",
      "!mindgest-pos-dev.db",
      "node_modules/@prisma/client/**/*"
    ],
    "asarUnpack": [
      "node_modules/@prisma/client/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-machine-id/**/*"
    ],
    "extraResources": [
      "prisma/**/*"
    ],
    "win": {
      "icon": "renderer/public/mindgest.png",
      "signAndEditExecutable": true,
      "legalTrademarks": "MindGest",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dev-mindware",
        "repo": "mindgest-pos-desktop"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MindGest POS"
    }
  },
  "bugs": {
    "url": "https://github.com/dev-mindware/mindgest-pos-desktop/issues"
  },
  "homepage": "https://github.com/dev-mindware/mindgest-pos-desktop#readme"
}
