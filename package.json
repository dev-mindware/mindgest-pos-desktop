    "@tailwindcss/postcss": "latest",
    "@tailwindcss/typography": "^0.5.19",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "latest",
    "@types/pdfmake": "^0.2.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "latest",
    "baseline-browser-mapping": "^2.10.0",
    "electron": "33.2.1",
    "electron-builder": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "nextron": "latest",
    "ollama": "^0.6.3",
    "orval": "^7.11.2",
    "postcss": "latest",
    "prisma": "^5.22.0",
    "tailwindcss": "latest",
    "tw-animate-css": "^1.3.2",
    "typescript": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dev-mindware/mindgest-pos-desktop.git"
  },
  "keywords": [],
  "author": "Mindware - Comércio & Serviços <suporte@mindware.ao>",
  "license": "ISC",
  "build": {
    "appId": "com.mindware.mindgest.pos",
    "productName": "MindGest POS",
    "copyright": "Copyright © 2026 Mindware - Comércio & Serviços",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "app/**/*",
      "renderer/out/**/*",
      "desktop-service/app/**/*",
      "desktop-service/assets/**/*",
      "desktop-service/config/**/*",
      "desktop-service/requirements.txt",
      "main/**/*",
      "package.json",
      "!desktop-service/venv",
      "!python-microservice",
      "!prisma/dev.db*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "legalTrademarks": "Mindware",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeader": "resources/installerHeader.bmp",
      "installerHeaderIcon": "resources/icon.ico",
      "installerSidebar": "resources/installerSidebar.bmp",
      "uninstallerSidebar": "resources/installerSidebar.bmp",
      "uninstallDisplayName": "MindGest POS - Ponto de Venda",
      "uninstallUrlHelp": "https://mindgest.mindware.ao/suporte",
      "uninstallUrlInfoAbout": "https://mindgest.mindware.ao",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MindGest POS",
      "include": "resources/installer.nsh",
      "guid": "8f7b58c2-3e21-4f89-8d77-628d09f7a931",
      "differentialPackage": true,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dev-mindware",
        "repo": "mindgest-pos-desktop"
      }
    ]
  },
  "bugs": {
    "url": "https://github.com/dev-mindware/mindgest-pos-desktop/issues"
  },
  "homepage": "https://github.com/dev-mindware/mindgest-pos-desktop#readme"
}
