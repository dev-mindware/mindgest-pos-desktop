// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  output     = "./client"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// Módulo de Segurança e Autenticação
// ==========================================

model User {
  id        String   @id @default(uuid())
  cloudId   String?  @unique // ID on the cloud MINDGEST-API
  name      String
  email     String   @unique
  role      String // Ex: CASHIER, MANAGER, ADMIN (Sincronizado da MINDGEST-API)
  password  String? // Password ou PIN local encriptado
  isActive  Boolean  @default(true)
  storeId   String // Contexto da Loja
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]
}

model Settings {
  id             String   @id @default("singleton") // Só existe 1 registo por instalação
  storeId        String? // Loja atual a que este terminal pertence
  hardwareId     String? // Impressão digital da máquina para segurança anti-cópia
  offlineLicense String? // JWT assinado pela cloud
  lastSync       DateTime @default(now())

  // Relógio Monotónico (Anti-Time-Travel)
  lastOperationTime DateTime? // Timestamp da última operação válida (para validação contínua)
  lastFraudAttempt  DateTime? // Última vez que foi detectada uma tentativa de fraude
  fraudAttemptCount Int       @default(0) // Contador de tentativas de fraude

  // Topologia Multi-Terminal (Fase 6)
  terminalMode String  @default("MASTER") // "MASTER" ou "TERMINAL"
  masterIp     String? // IP do Master (usado no modo TERMINAL)
  lanSecret    String? // Shared secret para autenticação LAN
}

// ==========================================
// Master Data (Sincronizado da Cloud para Local)
// ==========================================

model Client {
  id        String   @id @default(uuid())
  cloudId   String?  @unique
  offlineId String?  @unique
  name      String
  taxNumber String?
  email     String?
  phone     String?
  address   String?
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]
}

model Category {
  id          String   @id @default(uuid())
  cloudId     String?  @unique
  name        String
  description String?
  storeId     String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items Item[]
}

model Item {
  id          String    @id @default(uuid())
  cloudId     String?   @unique
  code        String?   @unique
  name        String
  description String?
  price       Float
  taxPercent  Float     @default(14.0) // Ex: IVA
  stock       Float     @default(0.0)
  barcode     String?   @unique
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  storeId     String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invoiceLines InvoiceLine[]
}

// ==========================================
// Transacional (Faturação e Stock JIT)
// ==========================================

model Invoice {
  id         String   @id @default(uuid())
  localNo    String   @unique // Ref interna local
  agtNo      String?  @unique // Numeração oficial (ex: FT 2026/1)
  status     String   @default("DRAFT") // DRAFT, VALID, CANCELED
  issueDate  DateTime @default(now())
  netTotal   Float
  taxTotal   Float
  grossTotal Float

  // AGT Security - Assinaturas locais
  hash        String?
  hashControl String?

  syncStatus String @default("PENDING") // PENDING, SYNCED, FAILED, PENDING_DEPENDENCIES

  // Relacionamentos
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])
  storeId  String

  lines InvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceLine {
  id         String  @id @default(uuid())
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item    @relation(fields: [itemId], references: [id])
  quantity   Float
  unitPrice  Float
  taxPercent Float
  discount   Float   @default(0.0)
  netTotal   Float
  grossTotal Float
}

// ==========================================
// Gestão de Caixa (Offline-First)
// ==========================================

model CashSession {
  id             String    @id @default(uuid())
  cloudId        String?   @unique
  openingDate    DateTime  @default(now())
  closingDate    DateTime?
  openingBalance Float
  closingBalance Float?
  totalSales     Float     @default(0.0)
  totalExpenses  Float     @default(0.0)
  status         String    @default("OPEN") // OPEN, CLOSED
  userId         String
  storeId        String

  movements CashMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CashMovement {
  id            String      @id @default(uuid())
  cloudId       String?     @unique
  type          String // IN (Reforço), OUT (Sangria/Despesa), SALE (Venda)
  description   String
  amount        Float
  cashSessionId String
  cashSession   CashSession @relation(fields: [cashSessionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// Sincronização (Outbox Pattern)
// ==========================================

model SyncOutbox {
  id         String  @id @default(uuid())
  entityType String // Ex: INVOICE, CLIENT, CASH_MOVEMENT, PROFORMA
  entityId   String // ID local da entidade
  action     String // CREATE, UPDATE, DELETE
  payload    String // JSON Payload completo a enviar para a MINDGEST-API
  status     String  @default("PENDING") // PENDING, SYNCED, FAILED, PENDING_DEPENDENCIES
  errorMsg   String?
  storeId    String

  // Rastreamento de dependências (ex: INVOICE depende de CLIENT)
  dependsOnType String? // Ex: "CLIENT"
  dependsOnId   String? // Ex: clientId

  // Retry logic
  retryCount    Int       @default(0)
  lastErrorTime DateTime?
  syncedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DocumentSequence {
  id              String  @id @default(uuid())
  cloudId         String? @unique
  companyCode     String
  storeCode       String
  documentType    String  @default("FP")
  seriesYear      String
  versionCode     String  @default("01")
  seriesCode      String  @unique
  currentSequence Int     @default(0)
  lastDocumentNo  Int     @default(5000)
  isClosed        Boolean @default(false)

  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyCode, storeCode, documentType, seriesYear, versionCode])
}

// AGT Series local model (permitirá operações atômicas via Prisma)
model AgtSeries {
  id                  String   @id @default(uuid())
  seriesCode          String?  @unique
  documentType        String
  seriesYear          String
  companyId           String
  establishmentNumber String
  storeId             String?
  currentSequence     Int      @default(0)
  lastDocumentNo      String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([documentType, seriesYear, companyId, establishmentNumber], name: "AgtSeries_documentType_seriesYear_companyId_establishmentNumber_key")
}
