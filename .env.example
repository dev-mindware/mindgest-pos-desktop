# ==============================================================================
# Mindgest POS Desktop - Configuração de Variáveis de Ambiente
# ==============================================================================

# URL da API Cloud (MINDGEST-API)
# Staging: https://test.mindgest.mindware-vps.cloud/api
# Produção: https://api.mindgest.mindware.ao/api
# Desenvolvimento Local: http://localhost:4000/api
NEXT_PUBLIC_API_URL=https://test.mindgest.mindware-vps.cloud/api

# Chave de Autenticação da API Pública do Mindgest
NEXT_PUBLIC_API_KEY=sua_api_key_publica_aqui

# Porta do Servidor Local LAN Master (Opcional - padrão: 3333)
LOCAL_API_PORT=3333

# Conexão SQLite Local (Prisma ORM)
DATABASE_URL="file:./prisma/dev.db"
